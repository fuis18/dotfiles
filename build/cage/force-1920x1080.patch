+		if (!wl_list_empty(&wlr_output->modes)) {
+			struct wlr_output_mode *preferred_mode = wlr_output_preferred_mode(wlr_output);
+			if (preferred_mode) {
+				wlr_output_state_set_mode(&state, preferred_mode);
+			}
 		}
